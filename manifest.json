{
  "manifest_version": 3,
  "name": "Language Tutor in YouTube",
  "version": "1.1.0",
  "description": "觀看 YouTube 時自動分段暫停，整理單字與片語並帶你逐句複習。",
  "homepage_url": "https://github.com/UncleLin332/youtube-language-tutor",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Language Tutor in YouTube（點擊開啟或前往設定）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content/lib.js",
        "shared/anki.js",
        "content/transcript.js",
        "content/segmenter.js",
        "content/panel.js",
        "content/app.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
